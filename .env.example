POSTGRES_DB=yourvoice
POSTGRES_USER=yourvoice
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

YOURVOICE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
YOURVOICE_JWT_SECRET=change-me-local-jwt-secret-at-least-32-characters-long
YOURVOICE_JWT_ISSUER=yourvoice-api
YOURVOICE_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
YOURVOICE_JWT_REFRESH_TOKEN_EXPIRATION_HOURS=12
YOURVOICE_LOGIN_MAX_FAILURES=5
YOURVOICE_LOGIN_LOCK_SECONDS=900
YOURVOICE_ID_HASH_PEPPER=change-me-local-id-hash-pepper-at-least-32-characters
YOURVOICE_VOTE_CREDENTIAL_PEPPER=change-me-local-vote-credential-pepper-at-least-32-characters
YOURVOICE_RATE_LIMIT_ENABLED=true
YOURVOICE_RATE_LIMIT_WINDOW_SECONDS=60
YOURVOICE_RATE_LIMIT_AUTH_LIMIT=100
YOURVOICE_RATE_LIMIT_BOOTSTRAP_LIMIT=20
YOURVOICE_RATE_LIMIT_CREDENTIAL_LIMIT=100
YOURVOICE_RATE_LIMIT_BALLOT_LIMIT=100
YOURVOICE_ADMIN_BOOTSTRAP_ENABLED=true
YOURVOICE_ADMIN_BOOTSTRAP_TOKEN=change-me-local-admin-bootstrap-token-at-least-32-characters
