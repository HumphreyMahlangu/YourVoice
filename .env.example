POSTGRES_DB=votetrust
POSTGRES_USER=votetrust
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

VOTETRUST_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VOTETRUST_JWT_SECRET=change-me-local-jwt-secret-at-least-32-characters-long
VOTETRUST_JWT_ISSUER=votetrust-api
VOTETRUST_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
VOTETRUST_JWT_REFRESH_TOKEN_EXPIRATION_HOURS=12
VOTETRUST_LOGIN_MAX_FAILURES=5
VOTETRUST_LOGIN_LOCK_SECONDS=900
VOTETRUST_ID_HASH_PEPPER=change-me-local-id-hash-pepper-at-least-32-characters
VOTETRUST_VOTE_CREDENTIAL_PEPPER=change-me-local-vote-credential-pepper-at-least-32-characters
VOTETRUST_RATE_LIMIT_ENABLED=true
VOTETRUST_RATE_LIMIT_WINDOW_SECONDS=60
VOTETRUST_RATE_LIMIT_AUTH_LIMIT=100
VOTETRUST_RATE_LIMIT_BOOTSTRAP_LIMIT=20
VOTETRUST_RATE_LIMIT_CREDENTIAL_LIMIT=100
VOTETRUST_RATE_LIMIT_BALLOT_LIMIT=100
VOTETRUST_ADMIN_BOOTSTRAP_ENABLED=true
VOTETRUST_ADMIN_BOOTSTRAP_TOKEN=change-me-local-admin-bootstrap-token-at-least-32-characters
